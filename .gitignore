# ====================================================================
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.suo
*.userprefs
*.pidb
*.booproj
*.svclog

# Visual Studio / Rider / VS Code cache
.vs/
.idea/
*.DotSettings.user
_ReSharper*/

# Publish outputs
publish/
[Aa]pp/[Pp]ublish/

# ====================================================================
# Operating System & Container Logs
# ====================================================================
*.log
Thumbs.db
ehthumbs.db
Desktop.ini
