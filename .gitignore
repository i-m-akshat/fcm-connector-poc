# ====================================================================
# Security & Secrets (NEVER COMMIT SENSITIVE CREDENTIALS)
# ====================================================================

# Environment variable files containing real keys
.env
.env.*
!.env.example

# Secrets folder contents (keep README.md for instructions)
secrets/*
!secrets/README.md

# Firebase & Cloud Service Account private keys
*adminsdk*.json
*service-account*.json
*firebase-key*.json
*firebase_key*.json
*.json.secret
google-services.json
GoogleService-Info.plist
*.p8
*.p12
*.pem
*.key

