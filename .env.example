# ====================================================================
# Firebase Connector - Template (.env.example)
# Copy this file to .env and replace with your actual values:
# cp .env.example .env
# ====================================================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
API_PORT=5000
REDIS_PORT=6379

ConnectionStrings__Redis=redis:6379

# Multi-App Secret Convention:
# Pattern: FIREBASE_APP_<APP_NAME>_JSON='<JSON_CONTENT_OR_BASE64>'
FIREBASE_APP_CUSTOMER_JSON='{"type":"service_account","project_id":"your-customer-project",...}'
FIREBASE_APP_DRIVER_JSON='{"type":"service_account","project_id":"your-driver-project",...}'
FIREBASE_DEFAULT_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-default-project",...}'
